    {
      "name": "05 - Citas",
      "description": "Agendamiento de citas con validacion de cruces.",
      "item": [
        {
          "name": "P09 - Agendar cita (201)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const url = pm.variables.replaceIn(\"{{baseUrl}}/api/citas/disponibilidad?idBarbero={{idBarbero}}&fecha={{fechaCita}}&idServicio={{idServicioDemo}}\");",
                  "pm.sendRequest({ url, method: \"GET\", header: { Authorization: \"Bearer \" + pm.collectionVariables.get(\"tokenCliente\") } }, (err, res) => {",
                  "  const horas = (!err && res.code === 200) ? res.json().datos.horas : [];",
                  "  const hora = horas.length ? horas[0] : \"10:00\";",
                  "  const [hh, mm] = hora.split(\":\");",
                  "  pm.collectionVariables.set(\"horaCita\", hora);",
                  "  pm.collectionVariables.set(\"horaOcupada\", hh + \":\" + String(Number(mm) + 15).padStart(2, \"0\"));",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Codigo de estado 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"exito = true\", () => pm.expect(pm.response.json().exito).to.eql(true));",
                  "pm.test(\"Queda pendiente de confirmacion\", () => { pm.expect(pm.response.json().datos.estado).to.eql(\"pendiente\") });",
                  "pm.collectionVariables.set(\"idCita\", pm.response.json().datos.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenCliente}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/citas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "citas"
              ]
            },
            "description": "El cliente agenda una cita en la primera hora libre del barbero.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idBarbero\": {{idBarbero}},\n  \"idServicio\": {{idServicioDemo}},\n  \"fechaHora\": \"{{fechaCita}}T{{horaCita}}\",\n  \"notas\": \"Corte bajito a los lados\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
