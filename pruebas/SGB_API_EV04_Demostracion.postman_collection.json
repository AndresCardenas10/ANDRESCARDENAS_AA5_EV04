  },
  "item": [
    {
      "name": "00 - Preparacion",
      "description": "Peticiones previas: estado de la API y tokens de administrador y barbero.",
      "item": [
        {
          "name": "Estado de la API",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Codigo de estado 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"exito = true\", () => pm.expect(pm.response.json().exito).to.eql(true));",
                  "const d = new Date(); d.setDate(d.getDate() + 14 + Math.floor(Math.random() * 105));",
                  "while (d.getDay() === 0 || d.getDay() === 6) d.setDate(d.getDate() + 1);",
                  "const f = (x) => `${x.getFullYear()}-${String(x.getMonth()+1).padStart(2,\"0\")}-${String(x.getDate()).padStart(2,\"0\")}`;",
                  "pm.collectionVariables.set(\"fechaCita\", f(d));",
                  "pm.collectionVariables.set(\"sufijo\", String(Date.now()).slice(-7));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/salud",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "salud"
              ]
            },
            "description": "Comprueba que la API y la base de datos responden y fija la fecha de prueba."
          },
          "response": []
        },
