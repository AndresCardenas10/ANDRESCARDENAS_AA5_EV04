# Plantilla de configuracion. Copie este archivo como ".env" y ajuste los valores.
# El archivo ".env" NO se sube al repositorio (esta en .gitignore).

# Puerto del servidor (API + frontend)
PORT=3000

# Base de datos del SGB (XAMPP del proyecto usa el puerto 3307)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=sgb

# Clave para firmar los tokens de sesion (JWT). Cambiela por un texto largo y secreto.
JWT_SECRET=cambie-esta-clave-por-una-larga-y-secreta-123
JWT_EXPIRA=8h

# true: el codigo de recuperacion de contrasena se muestra en la respuesta (no hay correo)
MODO_DESARROLLO=true

# Minutos que tiene una cita pendiente para ser confirmada antes de cancelarse sola (RF06)
MINUTOS_CONFIRMACION_CITA=60
